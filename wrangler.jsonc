{
  "name": "mathnasium-schedule-maker",
  "main": "server/ai-worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "AI_ENABLED": "true", "OPENAI_MODEL": "gpt-4o-mini" },
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
  ],
  "observability": { "enabled": false },
}
